# .env.example - .env fayl yaratish uchun namuna
# Ushbu faylni nusxa olib, .env nomini berdingiz va API kalitingizni qo'ying

# Kimi K2P6 API Kaliti
KIMI_API_KEY=your_kimi_api_key_here

# API URL (o'zingizga moslashtiring)
KIMI_API_URL=https://api.kimi.com/v1

# Model nomini (o'zingizga moslashtiring)
KIMI_MODEL=kimi-k2p6

# Chunk hajmi (belgilar)
CHUNK_SIZE=15000

# Qayta urinishlar soni
MAX_RETRIES=3

# Timeout (soniya)
TIMEOUT=60
